# Cloud API
PWS_APP_KEY=replace-with-a-long-random-value
PWS_INGEST_KEY=replace-with-a-different-long-random-value

# Render setter DATABASE_URL automatisk når Blueprint-databasen brukes.
# Lokal utvikling kan bruke SQLite:
DATABASE_URL=sqlite:///./pws.db

# Collector (kun lokalt på PC)
PWS_CLOUD_URL=https://your-service.onrender.com
PWS_SORLANDET_JSON=C:\path\to\pws_live_data.json
PWS_TRIADEN_JSON=C:\path\to\pws_triaden_live_data.json
